generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  role     String  @default("USER")
  orders   Order[]
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id             String      @id @default(uuid())
  name           String
  price          Float
  stock          Int         @default(0)
  unlimitedStock Boolean     @default(false)
  image          String?
  isCombo        Boolean     @default(false)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  total         Float
  deliveryType  String      @default("PICKUP")
  address       String?
  phone         String?
  notes         String?
  deliveryTime  String?
  status        String      @default("PENDING")
  paymentStatus String      @default("PENDING")
  paymentId     String?
  createdAt     DateTime    @default(now())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id          String     @id @default(uuid())
  quantity    Int
  price       Float
  productName String?
  orderId     String
  productId   String?
  order       Order      @relation(fields: [orderId], references: [id])
  product     Product?   @relation(fields: [productId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model Promotion {
  id            String    @id @default(uuid())
  title         String
  description   String
  image         String?
  price         Float
  originalPrice Float?
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
}
