generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  role          String         @default("USER")
  resetToken    String?
  resetTokenExpiry DateTime?
  orders        Order[]
  loyaltyPoints LoyaltyPoint[]
  addresses     Address[]
}

model Category {
  id         String     @id @default(uuid())
  name       String
  parentId   String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]
}

model Product {
  id             String       @id @default(uuid())
  name           String
  description    String?
  price          Float
  stock          Int          @default(0)
  unlimitedStock Boolean      @default(false)
  image          String?
  isCombo        Boolean      @default(false)
  isFeatured     Boolean      @default(false)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  pointRewards   PointReward[]
}

model Order {
  id             String        @id @default(uuid())
  total          Float
  deliveryType   String        @default("PICKUP")
  deliveryCost   Float         @default(0)
  address        String?
  phone          String?
  notes          String?
  deliveryTime   String?
  status         String        @default("PENDING")
  createdAt      DateTime      @default(now())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id          String     @id @default(uuid())
  quantity    Int
  price       Float
  productName String?
  orderId     String
  productId   String?
  order       Order      @relation(fields: [orderId], references: [id])
  product     Product?   @relation(fields: [productId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model Promotion {
  id            String    @id @default(uuid())
  title         String
  description   String
  image         String?
  price         Float
  originalPrice Float?
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
}

model DeliveryZone {
  id            String    @id @default(uuid())
  name          String
  basePrice     Float
  surcharge     Float     @default(0)
  maxDistanceKm Float?
  active        Boolean   @default(true)
  orders        Order[]
  addresses     Address[]
}

model LoyaltyPoint {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
}

model PointReward {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  image       String?
  active      Boolean  @default(true)
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  street    String
  number    String
  notes     String?
  zoneId    String?
  zone      DeliveryZone? @relation(fields: [zoneId], references: [id])
  isDefault Boolean @default(false)
}
